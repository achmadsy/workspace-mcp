# Workspace MCP configuration
# Copy to a secure location (never commit real credentials).

# Absolute path to the project Claude may access. Everything is sandboxed here.
WORKSPACE_ROOT=/absolute/path/to/project

# Listener. Keep loopback; Cloudflare Tunnel connects locally.
MCP_HOST=127.0.0.1
MCP_PORT=8787

# local: no auth, loopback only, for development.
# public: behind Cloudflare Tunnel, OAuth 2.1 required.
MCP_MODE=local

# Required in public mode: the EXACT URL entered in Claude.ai, ending in /mcp.
# Changing it invalidates all OAuth clients/tokens (each Quick Tunnel URL is new).
#MCP_PUBLIC_URL=https://mcp.example.com/mcp

# Required in manually configured public mode: the single operator password for
# the OAuth consent page. scripts/start-tunnel.sh generates and securely reuses
# this automatically for Quick Tunnels.
#MCP_ADMIN_PASSWORD=change-me-long-random

# Required in manually configured public mode: directory for encrypted OAuth
# state (0700). Quick Tunnel default: ~/.local/share/workspace-mcp.
#MCP_STATE_DIR=/absolute/path/to/state

# Required in manually configured public mode: base64 of exactly 32 random
# bytes. scripts/start-tunnel.sh generates and persists this automatically.
# Generate manually: openssl rand -base64 32
#MCP_STATE_KEY=

# Set true only when serving behind Cloudflare Tunnel (rate limits per real client IP).
#MCP_TRUST_CLOUDFLARE_TUNNEL=false
