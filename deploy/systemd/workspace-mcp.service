[Unit]
Description=Workspace MCP server
After=network.target

[Service]
Type=simple
EnvironmentFile=@ENV_FILE@
ExecStart=@BIN@
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@WORKSPACE_ROOT@ @STATE_DIR@
LimitNOFILE=65535
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
